# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
# If local mongod is not running and no URI is specified, QueryMind automatically runs an in-memory database fallback so you can test right away!
MONGODB_URI=mongodb://127.0.0.1:27017/querymind

# JWT Secret for Session Authentication
JWT_SECRET=querymind_secret_jwt_key_987654321_ankita_2026
JWT_EXPIRE=7d

# Google Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Rate Limiting Configuration (100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
